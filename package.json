{
  "name": "stock-engine",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev:web": "pnpm --filter @stock-engine/web dev",
    "build": "pnpm --filter @stock-engine/web build",
    "typecheck": "pnpm --filter @stock-engine/web typecheck",

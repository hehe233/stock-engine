# Paths are relative to apps/api. The dev script always sets that working directory.
DATABASE_URL=sqlite:///./stock_engine.db
# PostgreSQL alternative (start the root compose.yaml first):
# DATABASE_URL=postgresql+psycopg://stock:stock_local@127.0.0.1:5432/stock_engine
REFRESH_INTERVAL_SECONDS=300
SCHEDULER_ENABLED=true
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# public: free public quotes; demo: offline fixtures. Never silently fall back to demo.
MARKET_PROVIDER=public
PUBLIC_SOURCE=eastmoney
PROVIDER_TIMEOUT_SECONDS=180

# OpenAI-compatible Chat Completions API. Key stays on the server.
# Model must support tool calling. Configure exactly the model names your provider accepts.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_MODELS=[]
MODEL_TIMEOUT_SECONDS=60
MAX_TOOL_ROUNDS=3

# Explicit fallback option, never automatically selected after an API failure.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

CHECKPOINT_SQLITE_PATH=./checkpoints.db
# CHECKPOINT_POSTGRES_URL=postgresql://stock:stock_local@127.0.0.1:5432/stock_engine
JOB_TIMEOUT_SECONDS=300
JOB_MAX_ATTEMPTS=3
MAX_PENDING_JOBS=20

# Production requires HTTPS and an application access key of at least 32 characters.
# APP_API_KEY is not the model provider key.
APP_ENVIRONMENT=development
APP_API_KEY=
